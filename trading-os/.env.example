# Copiar para .env.local e preencher.

# --- XTB xAPI (recomendado: conta demo dedicada só para o motor) ---
# Docs: http://developers.xstore.pro/documentation/
XTB_LOGIN=
XTB_PASSWORD=
XTB_ACCOUNT_TYPE=demo
XTB_SYMBOL=GOLD

# --- Fallback OHLC real (se xAPI falhar / sem creds) ---
# https://twelvedata.com/ — time_series XAU/USD
TWELVE_DATA_API_KEY=

