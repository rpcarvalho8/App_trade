# Copiar para .env.local e preencher.

# --- XAUUSD OHLC (OBRIGATÓRIO para o motor de ouro) ---
# Twelve Data — fonte PRIMÁRIA (xAPI XTB descontinuada em 14 mar 2025).
# Plano Basic free: 8 créditos/min · 800/dia — o poll default cabe (~411/dia).
# https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Poll opcional (ms) — defaults: M5=5min, M15=15min, H4=60min
# XAU_POLL_M5_MS=300000
# XAU_POLL_M15_MS=900000
# XAU_POLL_H4_MS=3600000

# --- XTB xAPI (OBSOLETO — não usar) ---
# Descontinuada pela XTB em 14/03/2025 (ws.xtb.com / xapi.xtb.com).
# Mantido só como comentário histórico — ver lib/marketdata/xtb-xapi.dead.ts
# XTB_LOGIN=
# XTB_PASSWORD=
# XTB_ACCOUNT_TYPE=demo
# XTB_SYMBOL=GOLD

# --- Alertas email (opcional) ---
# ALERT_EMAIL_TO=
# RESEND_API_KEY=
# ALERT_EMAIL_WEBHOOK=

# --- Gemini ---
# GEMINI_API_KEY=
