# Copiar para .env.local e preencher.

# --- XAUUSD OHLC (OBRIGATÓRIO para o motor de ouro) ---
# Twelve Data — fonte PRIMÁRIA (xAPI XTB descontinuada em 14 mar 2025).
# Plano Basic free: 8 créditos/min · 800/dia — o poll default cabe (~411/dia).
# https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Poll alinhado ao fecho de vela (defaults): M5=5min, M15=15min, H4=4h
# Já não há XAU_POLL_* — o gate é por barra (floorTime); tick interno 60s.

# --- XTB xAPI (OBSOLETO — não usar) ---
# Descontinuada pela XTB em 14/03/2025 (ws.xtb.com / xapi.xtb.com).
# Mantido só como comentário histórico — ver lib/marketdata/xtb-xapi.dead.ts
# XTB_LOGIN=
# XTB_PASSWORD=
# XTB_ACCOUNT_TYPE=demo
# XTB_SYMBOL=GOLD

# --- Alertas no telemóvel: Telegram (recomendado) ---
# 1) No Telegram, fala com @BotFather → /newbot → copia o token.
# 2) Envia /start ao teu bot e abre https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id": ...}
# 3) Testa: curl -X POST http://localhost:3000/api/alerts/test
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ALERT_TYPES=signal,setup,news   # junta ",calendar" para avisos antes/depois dos eventos macro

# Pausa entre sinais da mesma estratégia (ms). Default 15 min.
# SIGNAL_COOLDOWN_MS=900000

# --- Alertas email (opcional) ---
# ALERT_EMAIL_TO=
# RESEND_API_KEY=
# ALERT_EMAIL_WEBHOOK=

# --- Gemini ---
# GEMINI_API_KEY=
# Análise visual com zoom: resolução com que o Gemini lê os gráficos (vazio desliga)
# GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH

# --- Base de conhecimento (RAG) ---
# knowledge/ no repositório é sempre indexado. Junta o teu vault Obsidian (Daily Report Cards, notas):
# KNOWLEDGE_DIRS=/caminho/para/Trade/Estudo/Trade

# --- Notícias de última hora (lib/news-engine.ts) — fontes gratuitas, sem chave ---
# Fontes: investingLive (macro), Federal Reserve, SEC, CoinDesk, Cointelegraph, Decrypt.
# Crítico (score >= 8): toast + som + notificação do sistema + Telegram + email, e pausa
# os sinais do activo durante NEWS_SHOCK_BLOCK_MIN. Warning (>= 5): toast + Telegram.
# NEWS_ALERTS=off              # desliga o motor
# NEWS_POLL_SEC=90
# NEWS_MAX_AGE_MIN=30          # ignora notícias mais antigas do que isto
# NEWS_MIN_SCORE=5             # sobe para 6-7 se houver ruído
# NEWS_CRITICAL_SCORE=8
# NEWS_MIN_GAP_MIN=10          # intervalo mínimo entre warnings do mesmo activo
# NEWS_MAX_PER_HOUR=4          # teto por activo (críticos podem ir a +2)
# NEWS_SHOCK_BLOCK_MIN=15      # pausa de sinais após notícia crítica
# NEWS_EMAIL=off               # não enviar email nos críticos
# NEWS_DISABLED_FEEDS=decrypt,cointelegraph
# NEWS_EXTRA_FEEDS=https://exemplo.com/rss
# Reação do preço medida N min depois de cada evento de alto impacto do calendário:
# ALERTS_CAL_POST_MIN=3
